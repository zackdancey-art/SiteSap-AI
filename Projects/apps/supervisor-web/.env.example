# Copy to .env.local for local development. Never commit .env.local to source control.
# For the deployed dashboard, set these in the Render service's environment.

# ── API ───────────────────────────────────────────────────────────────────────
# The backend API base URL. Required in all environments.
#
# BUILD-TIME: Next inlines every NEXT_PUBLIC_* var into the client bundle, and this
# value ALSO builds the CSP `connect-src` in next.config.mjs. A wrong or empty value
# silently blocks every API call in the browser with no visible error. Changing it
# requires a REBUILD, not a restart.
#
# Dev:        http://localhost:4000        (your local API)
# Production: https://api.getsitesnapai.com  (set in the Render BUILD environment)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Developer tools ───────────────────────────────────────────────────────────
# Set to true only in development — never in production (it is baked into the bundle).
# When absent or false, the API Connection settings panel is hidden from all users.
# NEXT_PUBLIC_SHOW_DEV_TOOLS=true
