# Copy to .env.local for local development. Never commit .env.local to source control.
# In production (Vercel / Docker), set these as environment variables in your deployment config.

# ── API ───────────────────────────────────────────────────────────────────────
# The backend API base URL. Required in all environments.
# Dev: your machine's LAN IP running `pnpm run dev:api` (port 4001 by default)
# Production: set to your hosted API origin (e.g. https://api.sitesnap.app)
NEXT_PUBLIC_API_URL=http://192.168.4.28:4001

# ── Developer tools ───────────────────────────────────────────────────────────
# Set to true only in development — never in production.
# When absent or false, the API Connection settings panel is hidden from all users.
# NEXT_PUBLIC_SHOW_DEV_TOOLS=true
