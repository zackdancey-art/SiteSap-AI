# Copy to .env for local dev. Never commit .env to source control.
# For EAS builds, set these in eas.json "env" blocks or via `eas secret:create`.

# ── API ───────────────────────────────────────────────────────────────────────
# Dev: your machine's LAN IP running `pnpm run dev:api` (port 4001 by default)
# Production: injected by EAS build profile — do NOT hardcode a prod URL here.
EXPO_PUBLIC_API_URL=http://192.168.4.28:4001

# If both are set, EXPO_PUBLIC_API_BASE_URL takes precedence.
# EXPO_PUBLIC_API_BASE_URL=https://api.sitesnap.app

# ── Observability ─────────────────────────────────────────────────────────────
# Create a React Native project at sentry.io and paste the DSN here.
# Leave blank to disable crash reporting in dev.
EXPO_PUBLIC_SENTRY_DSN=

# ── Debug ─────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_INPUT_DEBUG=false
