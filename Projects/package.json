{
  "name": "sitesnap-monorepo",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "shared"
  ],
  "scripts": {
    "dev:api": "pnpm --filter ./services/api dev",
    "dev:mobile": "pnpm --filter ./apps/mobile dev",
    "kill:4000": "lsof -t -iTCP:4000 -sTCP:LISTEN | xargs kill -9 || true",
    "dev": "pnpm run dev:api",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint": "eslint \"{apps,services,shared}/**/*.{ts,tsx,js,jsx}\" --ext .ts,.tsx,.js --ignore-path .eslintignore",
    "lint:fix": "eslint \"{apps,services,shared}/**/*.{ts,tsx,js,jsx}\" --ext .ts,.tsx,.js --ignore-path .eslintignore --fix",
    "build:ts": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^20.5.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.46.0",
    "eslint-plugin-import": "^2.27.5",
    "typescript": "^5.9.3"
  }
}
